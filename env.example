# ── REQUIRED kwenye production (Render → Environment) ──
# Tengeneza kwa: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=badilisha-hii-kwa-thamani-random-ndefu
PASSWORD_SALT=badilisha-hii-kwa-thamani-nyingine-random-ndefu

# Ashiria kuwa hii ni production (inawasha SESSION_COOKIE_SECURE,
# inazuia debug mode, na inalazimisha SECRET_KEY/PASSWORD_SALT kuwepo)
FLASK_ENV=production

# Render huweka PORT yenyewe kiotomatiki — usiiguse
# PORT=5000

# ── SMTP (hiari — kama huna, app inatumia demo/console mode) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=info@njiamauzo.africa
