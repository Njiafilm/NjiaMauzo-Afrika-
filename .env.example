# NjiaMauzo Afrika — Environment Variables
# Copy to .env and fill real values. Never commit .env

SECRET_KEY=change-me-to-a-long-random-string
PASSWORD_SALT=change-me-password-salt

# Server
PORT=5000
FLASK_DEBUG=0

# Info email identity
INFO_EMAIL=info@njiamauzo.africa
INFO_NAME=NjiaMauzo Afrika
APP_URL=https://njiamauzo-afrika.onrender.com

# SMTP (for real email delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=1

# Payments
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
